easyblock = 'CMakeMake'

name = 'TRIQS-triqs_dftkit'
version = '@PROJECT_VERSION@'

homepage = 'https://triqs.github.io/dftkit/'
description = """
 DFT converters for TRIQS, enabling DFT+DMFT calculations.
"""

docurls = ['https://triqs.github.io/dftkit/%(version_major_minor)s.x/']
software_license = 'LicenseGPLv3'

toolchain = {'name': 'foss', 'version': '2021b'}
toolchainopts = {'pic': True, 'usempi': True}

source_urls = ['https://github.com/TRIQS/triqs_dftkit/releases/download/%(version)s/']
sources = ['triqs_dftkit-%(version)s.tar.gz']
checksums = ['PUT HERE THE SHA256 OF THE RELEASE TARBALL']

dependencies = [
    ('Python', '3.9.6'),
    ('SciPy-bundle', '2021.10'),
    ('Boost', '1.77.0'),
    ('Clang', '13.0.1'),
    ('Clang-Python-bindings', '13.0.1'),
    ('GMP', '6.2.1'),
    ('HDF5', '1.10.7'),
    ('Mako', '1.1.4'),
    ('TRIQS', '4.0.0'),
    ('NFFT', '3.5.2')
]

builddependencies = [
    ('CMake', '3.22.1')
]

separate_build_dir = True

runtest = 'test'

sanity_check_paths = {
    'files': ['lib/libtriqs_dftkit_c.a'],
    'dirs': ['include/triqs_dftkit', 'lib', 'share',
             'lib/python%(pyshortver)s/site-packages/triqs_dftkit'],
}

sanity_check_commands = ["python -c 'import triqs_dftkit'"]

modextrapaths = {
    'CPLUS_INCLUDE_PATH': 'include',
    'PYTHONPATH': 'lib/python%(pyshortver)s/site-packages',
    'CMAKE_PREFIX_PATH': 'lib/cmake/triqs_dftkit',
}
modextravars = {
    'TRIQS_DFTKIT_ROOT': '%(installdir)s',
    'TRIQS_DFTKIT_VERSION': '%(version)s',
}

moduleclass = 'phys'
